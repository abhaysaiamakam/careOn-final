# CareOn — Environment Variables
# Copy this file to .env and fill in secrets before running.
# NEVER commit the actual .env file to source control.

# ── Database ─────────────────────────────────────────────────────────────────
# Local development (PostgreSQL socket):
DATABASE_URL=postgresql+psycopg:///careon
# Docker Compose (use service name):
# DATABASE_URL=postgresql+psycopg://careon:your_password@postgres/careon
# SQLite (unit tests only, not for production):
# DATABASE_URL=sqlite:///./careon_test.db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Docker Compose: REDIS_URL=redis://redis:6379/0

# ── Application ───────────────────────────────────────────────────────────────
# Environment: development | staging | production
CAREON_ENV=development

# JWT secret key — MUST be a long random string in production
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
CAREON_SECRET_KEY=change_me_to_a_long_random_secret_in_production

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Connection Pooling ────────────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_COUNT=10
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_OTP_COUNT=5
RATE_LIMIT_OTP_WINDOW=60
RATE_LIMIT_EMERGENCY_COUNT=60
RATE_LIMIT_EMERGENCY_WINDOW=60
RATE_LIMIT_TRACKING_COUNT=60
RATE_LIMIT_TRACKING_WINDOW=60

# ── Docker Compose Secrets ────────────────────────────────────────────────────
# (Used by docker-compose.yml only — not needed for local dev)
POSTGRES_PASSWORD=change_me_in_production
