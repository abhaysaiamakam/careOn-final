# CareOn — Environment Variables
# Copy this file to .env and fill in secrets before running.
# NEVER commit the actual .env file to source control.

# ── Database ─────────────────────────────────────────────────────────────────
# Local development (PostgreSQL socket):
DATABASE_URL=postgresql+psycopg:///careon
# Docker Compose (use service name):
# DATABASE_URL=postgresql+psycopg://careon:your_password@postgres/careon
#
# Supabase PostgreSQL + PostGIS (Production):
# 1. Direct connection (Port 5432 - IPv6-only by default on Supabase unless IPv4 add-on is enabled; ideal for DDL migrations):
#    DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# 2. Session Pooler (Port 5432 - IPv4-only shared pooler; recommended for persistent backend application server):
#    DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# 3. Transaction Pooler (Port 6543 - IPv4-only shared pooler; prepared statements automatically disabled):
#    DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Note: If your database password contains special characters (@, #, $, %, etc.), URL-encode them.
# Example in Python: python -c "import urllib.parse; print(urllib.parse.quote_plus('P@ss#123'))"
#
# PostGIS Schema configuration (Supabase installs PostGIS in 'extensions' schema):
DB_SEARCH_PATH=public,extensions
# Connection pool budget calculation:
# Max Connections = (Replicas * Uvicorn Workers * (DB_POOL_SIZE + DB_MAX_OVERFLOW)) + Worker Daemon (1-2) + Admin/Migration (1)
# Keep conservative if connecting multiple workers/replicas to Supabase (e.g. micro tier limit is 60 direct connections):
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=900

# ── Reverse Proxy Security ───────────────────────────────────────────────────
# Explicit trusted upstream reverse proxy IP or CIDR (e.g., your Cloudflare/ALB/NGINX IP)
# Do NOT set to '*' in production. Defaults safely to 127.0.0.1 (local sidecar).
FORWARDED_ALLOW_IPS=127.0.0.1

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Docker Compose: REDIS_URL=redis://redis:6379/0
# Managed Redis (e.g. Upstash / Redis Cloud):
# REDIS_URL=rediss://default:your_redis_password@your-redis-endpoint.upstash.io:6379

# ── Application ───────────────────────────────────────────────────────────────
# Environment: development | staging | production
CAREON_ENV=development

# JWT secret key — MUST be a long random string in production (at least 64 hex chars / 512 bits)
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
CAREON_SECRET_KEY=change_me_to_a_long_random_secret_in_production

# CORS — comma-separated list of allowed origins (e.g. your Vercel frontend domains)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# ── Receiving Hospital Routing ───────────────────────────────────────────────
# In the initial deployment, acute emergency requests target the designated receiving facility.
# In production, replace with the verified real-world facility code registered in your production database:
CAREON_DESIGNATED_FACILITY_CODE=VRH-TRAUMA-01

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_COUNT=10
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_OTP_COUNT=5
RATE_LIMIT_OTP_WINDOW=60
RATE_LIMIT_EMERGENCY_COUNT=60
RATE_LIMIT_EMERGENCY_WINDOW=60
RATE_LIMIT_TRACKING_COUNT=60
RATE_LIMIT_TRACKING_WINDOW=60

# ── Google Maps Platform ──────────────────────────────────────────────────────
# Google Maps JavaScript API, Geocoding, and Places API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Docker Compose Secrets ────────────────────────────────────────────────────
# (Used by docker-compose.yml only — not needed for local dev)
POSTGRES_PASSWORD=change_me_in_production
